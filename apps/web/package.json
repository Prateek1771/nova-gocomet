{
  "name": "@nova/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "gen:dsl": "json2ts -i ../../packages/nova_dsl/schema/workflow.schema.json -o src/dsl/workflow.ts --bannerComment \"// Generated from nova_dsl (pnpm gen:dsl). Do not edit.\" && node -e \"require('fs').copyFileSync('../../packages/nova_dsl/schema/workflow.schema.json','src/dsl/workflow.schema.json')\"",
    "gen:api": "openapi-typescript ../../services/api/openapi.json -o src/lib/api-types.ts",
    "gen": "pnpm gen:dsl && pnpm gen:api"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.12.0",
    "elkjs": "^0.12.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.53.0",
    "monaco-editor": "^0.54.0",
    "monaco-yaml": "^5.5.1",
    "next": "16.3.8",
    "openid-client": "^6.8.8",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-pdf": "^11.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "json-schema-to-typescript": "^16.0.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.33.2"
}
