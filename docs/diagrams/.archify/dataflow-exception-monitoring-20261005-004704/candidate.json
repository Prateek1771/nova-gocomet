  "cards": [
    {
      "dot": "emerald",
      "title": "Main path",
      "items": [
        "Events land in ClickHouse via Kafka engine + materialised view",
        "A Temporal schedule queries dbt metrics against tenant thresholds",
        "Detected exceptions are business records in Postgres, deduped per shipment + type"
      ]
    },
    {
      "dot": "amber",
      "title": "Generic trigger",
      "items": [
        "Debezium streams the exceptions table to Kafka",
        "The trigger router starts exception_triage from any CDC topic",
        "No exception-specific code in the engine"
      ]
    },
    {
      "dot": "rose",
      "title": "Gates",
      "items": [
        "Jev answers actionable + customer-impacting; not actionable auto-closes with a note",
        "Ops lead accepts, overrides, or dismisses before any customer notification",
        "Analyst queries run read-only under the ClickHouse tenant row policy"
      ]
    }
  ]
