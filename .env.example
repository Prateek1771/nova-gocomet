# Copy to .env for running api/web outside Docker (`make up` needs none of this).
# Python (pydantic-settings) and Next.js read the same names.
DATABASE_URL=postgresql+asyncpg://nova_app:nova_app@localhost:5433/nova
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://nova_owner:nova_owner@localhost:5433/nova
KEYCLOAK_ISSUER=http://localhost:8180/realms/nova
# KEYCLOAK_JWKS_URL=            # defaults to ${KEYCLOAK_ISSUER}/protocol/openid-connect/certs
OTEL_EXPORTER_OTLP_ENDPOINT=

APP_URL=http://localhost:3300
OIDC_CLIENT_ID=nova-web
OIDC_CLIENT_SECRET=nova-web-dev-secret
NOVA_API_URL=http://localhost:8100
REDIS_URL=redis://localhost:6379

# LLM routing (LiteLLM, infra/litellm/config.<mode>.yaml): local | free | cheap | demo. Compose reads this
# file for the litellm container. free ($0, default) = Groq free tier + OpenRouter `:free` fallback, so it
# wants both keys; cheap + demo (paid) need only the OpenRouter key; local needs none.
LLM_MODE=free
GROQ_API_KEY=
OPENROUTER_API_KEY=
# outside Docker only (compose sets these for its containers)
S3_ENDPOINT=localhost:9100
LLM_BASE_URL=http://localhost:4100
