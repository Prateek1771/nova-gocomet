{
  "realm": "nova",
  "displayName": "Nova",
  "enabled": true,
  "organizationsEnabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "roles": {
    "client": {
      "nova-api": [
        {
          "name": "platform_admin",
          "description": "Manage tenants; no tenant data access"
        },
        {
          "name": "tenant_admin",
          "description": "Org users/roles, TenantConfig, budgets"
        },
        {
          "name": "process_designer",
          "description": "FDE: edit and publish workflows and apps"
        },
        {
          "name": "ops_exec",
          "description": "Upload docs, start runs, complete assigned tasks"
        },
        {
          "name": "ops_lead",
          "description": "Ops exec + approve within limit"
        },
        {
          "name": "finance",
          "description": "Approve within limit, analytics"
        },
        {
          "name": "controller",
          "description": "Final approver"
        },
        {
          "name": "auditor",
          "description": "Read runs, analytics and audit log"
        },
        {
          "name": "viewer",
          "description": "Read only"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "nova-api",
      "name": "Nova API (audience + roles)",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "nova-web",
      "name": "Nova web (Next.js BFF)",
      "enabled": true,
      "publicClient": false,
      "secret": "nova-web-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3300/api/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:3300"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3300/*"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles",
        "web-origins",
        "acr"
      ],
      "optionalClientScopes": [
        "organization"
      ],
      "protocolMappers": [
        {
          "name": "audience nova-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "nova-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "organization",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-organization-membership-mapper",
          "config": {
            "claim.name": "organization",
            "multivalued": "true",
            "addOrganizationId": "true",
            "jsonType.label": "JSON",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "nova-admin",
      "name": "Nova provisioning (service account)",
      "enabled": true,
      "publicClient": false,
      "secret": "nova-admin-dev-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
